    # Dependencies
    **/node_modules/

    # Build output
    **/dist/
    **/build/
    **/.vite/
    **/coverage/

    # Environment files and secrets
    **/.env
    **/.env.*
    !**/.env.example

    # Logs
    *.log
    npm-debug.log*
    yarn-debug.log*
    pnpm-debug.log*

    # Editor and operating-system files
    .vscode/*
    !.vscode/extensions.json
    .idea/
    .DS_Store
    Thumbs.db

    # Local tool state
    .eslintcache
    *.tsbuildinfo
